# --- Base de datos (Postgres) ---
DATABASE_URL=postgres://user:password@localhost:5432/ronda

# --- Servidor ---
PORT=8787
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
ROOM_INACTIVITY_MINUTES=30
ROOM_PRESENCE_TIMEOUT_SECONDS=90

# --- Web (expuesta al navegador) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:8787

# --- Precio justo: Amazon Creators API (opcional) ---
# Requiere cuenta de Amazon Afiliados aceptada y acceso a Creators API.
# Nunca expongas estas credenciales en NEXT_PUBLIC_* ni en el navegador.
AMAZON_PRICE_JUSTO_ENABLED=false
AMAZON_CREATORS_API_CREDENTIAL_ID=
AMAZON_CREATORS_API_CREDENTIAL_SECRET=
# España usa la región europea (Creators API credential version 3.2).
AMAZON_CREATORS_API_VERSION=3.2
AMAZON_PARTNER_TAG=tu-tag-21
AMAZON_MARKETPLACE=www.amazon.es
AMAZON_PRICE_JUSTO_MAX_ITEMS_PER_CATEGORY=6
AMAZON_PRICE_JUSTO_REFRESH_MINUTES=60
