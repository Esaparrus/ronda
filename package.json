{
  "name": "ronda",
  "version": "0.0.0",
  "private": true,
  "description": "Ronda — web-app instalable (PWA) para jugar al Chinchón en grupo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter @ronda/web dev",
    "dev:web": "pnpm --filter @ronda/web dev",
    "dev:server": "pnpm --filter @ronda/server dev",
    "build": "pnpm --filter @ronda/web build && pnpm --filter @ronda/server build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "sim": "pnpm --filter @ronda/server sim",
    "db:migrate": "pnpm --filter @ronda/server db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
